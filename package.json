{
  "name": "tanks-battle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist-server/main.js",
    "start": "tsx src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "check:map": "tsx scripts/check-map.ts",
    "check:smoothness": "tsx scripts/check-smoothness.ts",
    "check:combat": "tsx scripts/check-combat.ts",
    "check:bots": "tsx scripts/check-bots.ts",
    "check:effects": "tsx scripts/check-effects.ts",
    "check:expedition": "tsx scripts/check-expedition.ts",
    "check:view": "tsx scripts/check-view.ts",
    "bench:pve": "tsx scripts/bench-pve.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
